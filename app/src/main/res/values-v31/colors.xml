<?xml version='1.0' encoding='utf-8' ?>
<resources>
    <color name="background">@android:color/system_accent1_100</color>
    <color name="foreground">@android:color/system_neutral2_700</color>
    <!-- 🔥🔥 [修复] 启动页背景使用固定白色，避免跟随系统强调色 -->
    <color name="splash_background">@android:color/white</color>
    <!-- Match AOSP's light themed-icon palette while keeping launcher tinting launcher-owned. -->
    <color name="splash_bilipai_monet_background">@android:color/system_accent1_100</color>
    <color name="splash_bilipai_monet_foreground">@android:color/system_accent1_700</color>
    <!-- Launcher shortcut icons follow the wallpaper-derived Monet accent on Android 12+. -->
    <color name="shortcut_icon_tint">@android:color/system_accent1_600</color>
</resources>
