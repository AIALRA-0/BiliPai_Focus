<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="startup_recovery.xml" />
        <exclude domain="file" path="android17_profiles/" />
        <exclude domain="file" path="profiling/" />
        <exclude domain="sharedpref" path="token_backup_sp.xml" />
        <exclude domain="sharedpref" path="multi_account_sessions.xml" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="logs/" />
        <exclude domain="sharedpref" path="startup_recovery.xml" />
        <exclude domain="file" path="android17_profiles/" />
        <exclude domain="file" path="profiling/" />
        <exclude domain="sharedpref" path="token_backup_sp.xml" />
        <exclude domain="sharedpref" path="multi_account_sessions.xml" />
        <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
